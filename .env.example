# Copy to .env and fill in your own values. Never commit a real DATABASE_URL or RPC URL.
# Postgres connection string for the CRE8 ATP off-chain database. Required: src/config.ts throws without it.
DATABASE_URL=postgres://cre8:cre8@localhost:5432/cre8_atp

# HTTP port the API listens on. Default in code: 8080.
PORT=8080

# BNB Chain id. 56 = mainnet (default), 97 = testnet.
CHAIN_ID=56

# EIP-4361 (SIWE) domain the wallet is asked to sign for: a bare authority, no scheme or path.
# Default in code: localhost. Deployments must set their own, e.g. app.cre8.xyz.
AUTH_DOMAIN=localhost

# Optional EIP-4361 uri (the resource the sign-in is for). Empty means http://<AUTH_DOMAIN>.
# Set it explicitly in a deployment, e.g. https://app.cre8.xyz.
AUTH_URI=

# JSON-RPC endpoint for on-chain operations (e.g. an Anvil BSC-mainnet fork, or a public BSC RPC).
# Empty means "chain disabled": strategy create/publish stay DB-only, and enroll returns 400.
RPC_URL=

# Backend relayer key only (0x-prefixed): registry operator (enroll/setPaused) and strategy provider.
# Separate from the deployer, alto bundler executor, and Safe owner; never use their keys here.
# Empty means "chain disabled". Never commit a real key.
OPERATOR_PRIVATE_KEY=

# Public relayer address for scheduler gas monitoring without an operator signing key.
# Must match the relayer address; RPC_URL remains required for readonly monitoring.
OPERATOR_ADDRESS=

# Read-only preflight settings: public addresses only; the deployer key is used only by forge script,
# and the bundler key stays in alto. --strict requires both nonzero addresses, pairwise distinct
# from the relayer and each other, and all three distinct from ATP_SAFE.
DEPLOYER_ADDRESS=
BUNDLER_EXECUTOR_ADDRESS=

# Chain 97 operator account deployment: shared persistent UTC-day attempts / native balance floor.
ACCOUNT_DEPLOYMENTS_PER_DAY=300
ACCOUNT_DEPLOYMENT_MIN_BALANCE_WEI=50000000000000000
RATE_LIMIT_ENROLLMENT_PER_MINUTE=30

# On-chain AtpRegistry address. Empty means "chain disabled".
REGISTRY_ADDRESS=

# Read-only preflight setting: expected v2 owner for registry and executor.oracle() (AtpMultiPoolOracle).
# Public Safe contract address, NOT a private key. --strict requires owner == ATP_SAFE and deployed code.
# transferOwnership alone is not enough: the Safe must call acceptOwnership on both contracts.
ATP_SAFE=

# Session key（Kernel permission validator）設定：enroll 會用這兩項部署一個「已安裝 session key 權限」的
# smart account，並把 session key 的派生路徑寫進 DB（私鑰永不落 DB）。未設時 enroll 會帶著變數名失敗。
# Session key CallPolicy 允許呼叫的 target（rebalance executor 合約地址）。
EXECUTOR_ADDRESS=

# HD 派生 session key 的 master seed（0x + 64 hex）。派生路徑 m/44'/60'/0'/0/<index>，
# index 由 keccak256(owner, strategyId) 決定，所以同一 (owner, strategyId) 重跑必然同一把金鑰。
SESSION_KEY_MASTER_SEED=

# Where the UserOp is submitted. Empty = the direct eth_sendUserOperation path against
# BUNDLER_URL. The bundler relay (POST /bundler) forwards here too.
BUNDLER_URL=http://127.0.0.1:3001

# SIWE wallets allowed to use ALL /operator/* endpoints (comma-separated EVM addresses).
# Empty/unset denies every wallet. These are public login addresses, independent of
# OPERATOR_PRIVATE_KEY (the backend relayer); never put private keys here.
OPERATOR_WALLETS=

# Enables POST /portfolios/:id/rebalance and POST /operator/portfolios/:id/{rebalance,close}.
# The /operator/* endpoints also require a SIWE wallet in OPERATOR_WALLETS.
# These endpoints sign with the account's session key and send real on-chain
# transactions that move the portfolio's money. Default OFF: they answer 403
# OPERATOR_REBALANCE_DISABLED and does not exist as far as callers are concerned.
# A deployment that runs the scheduler does not need it. Turn it on deliberately.
ENABLE_OPERATOR_REBALANCE=

# Optional Telegram critical alerts: fill BOTH or leave BOTH empty (disabled).
# Never commit a real bot token. Setup / chat id steps: README.md → Telegram 警示.
# dry-run also sends notifications, marked [dry-run]. Delivery errors only log; no retries.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Normally leave empty: https://api.telegram.org. Local fake Telegram server only for tests.
TELEGRAM_API_BASE=

# Chain 97 only: first empty-account purchase automatically mints 10,000 test USDT.
# Independent welcome site cap, 18 decimals (default 5,000,000/day; 0 stops new grants).
WELCOME_USDT_SITE_DAILY_WEI=5000000000000000000000000
# Daily faucet remains 1,000/owner/UTC day, site 1,000,000/day; welcome does not consume it.
# Owner-wallet gas subsidy: explicit opt-in, chain 97 only. Amounts are integer wei.
# Owner 1 attempt/UTC day and site transfer cap are in memory: restart resets them;
# each API replica has its own cap. Failed/unknown broadcasts retain the attempt budget.
GAS_FAUCET_ENABLED=0
GAS_FAUCET_THRESHOLD_WEI=200000000000000
GAS_FAUCET_TARGET_WEI=500000000000000
GAS_FAUCET_SITE_DAILY_WEI=50000000000000000
# Testnet investor demo: points/tasks/invites stay disabled; existing data is preserved.
POINTS_ENABLED=0

# BE-3: reads/API stay available on the reviewed chain-97 profile. Leave sending off until BE-4 + DB 0040 + local integration are reviewed.
ENABLE_YIELD_EXECUTION=0

# Official public GET collectors; independent of trading --live. Default disabled.
INFO_COLLECTORS_ENABLED=0
INFO_COLLECTORS_INTERVAL_SECONDS=1800
# Durable BLS 25-request/UTC-day attempt slots. Preserve and share across schedulers behind one IP.
INFO_COLLECTORS_STATE_DIR=.info-collectors
# Header provided by operations; never hard-code a contact address. Unset disables SEC and logs once per round.
SEC_USER_AGENT=

# Anthropic drafts are opt-in and always need human operator review before publication.
INFO_DRAFT_ENABLED=0
INFO_DRAFT_MODEL=claude-haiku-5-5
INFO_DRAFT_BATCH_SIZE=10
INFO_DRAFT_DAILY_LIMIT=100
# Preserve and share for schedulers using the same API key/DB; contains only quotas/retry state.
INFO_DRAFT_STATE_DIR=.info-collectors
ANTHROPIC_API_KEY=
