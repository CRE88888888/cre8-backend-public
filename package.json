{
  "name": "cre8-atp-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CRE8 ATP off-chain API: strategies, versions and the operation log (Postgres, no ORM).",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "migrate": "bun src/migrate.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "bun test"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
